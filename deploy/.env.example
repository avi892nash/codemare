# Production settings for docker-compose.prod.yml. Copy to deploy/.env on the
# server (git-ignored), fill in every CHANGE-ME, then
#   docker compose --env-file deploy/.env -f docker-compose.prod.yml up -d --build
# Generate secrets with `openssl rand -hex 32` (hex keeps them URL-safe:
# the database passwords end up inside connection strings).
# Values here are placeholders that only make `compose config` pass.

# ── domains & TLS ──────────────────────────────────────────────────────────
APP_DOMAIN=codemare.example.com
ADMIN_DOMAIN=admin.codemare.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=ops@example.com
# Published ports of caddy (only change for local tests).
HTTP_PORT=80
HTTPS_PORT=443

# ── release ────────────────────────────────────────────────────────────────
# Image tag; deploy/deploy.sh sets it to the git commit. Keep the previous
# tag's images around to roll back (deploy/README.md, "Rollback").
CODEMARE_VERSION=latest

# ── Postgres ───────────────────────────────────────────────────────────────
CODEMARE_DB=codemare
# Superuser: used by db-init and manual restores only.
POSTGRES_PASSWORD=CHANGE-ME-postgres-superuser
# Role `codemare`: owns app.* + content.*, used by web and migrations.
CODEMARE_DB_PASSWORD=CHANGE-ME-codemare-role
# Role `directus`: its own schema + row access to content.*.
DIRECTUS_DB_PASSWORD=CHANGE-ME-directus-role
# Role `codemare_backup`: read-only (pg_read_all_data), used by pg_dump.
BACKUP_DB_PASSWORD=CHANGE-ME-backup-role

# ── web ────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=CHANGE-ME-auth-secret
# Shared with the compile service (X-Codemare-Token). openssl rand -hex 32
INTERNAL_TOKEN=CHANGE-ME-internal-token-64-hex
# GitHub OAuth app (callback https://APP_DOMAIN/api/auth/callback/github); optional.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
FEATURE_LIBRARY_PUBLIC=false
FEATURE_AI_REVIEW=false
ANTHROPIC_API_KEY=
# Password-reset mail via Resend's HTTP API (web/lib/mailer.ts). Unset ->
# the links are only printed in the web container's log.
MAIL_FROM=
RESEND_API_KEY=
# Seed web/prisma/seed/data on start. Uses insert-missing: only new slugs are
# added and existing rows (including staff edits in Directus) are left alone.
SEED_ON_START=false

# ── compile service (backend) ──────────────────────────────────────────────
# Cap for the whole sandbox container: the server plus every running box.
BACKEND_MEMORY_LIMIT=4g
# round-robin: every run box gets one CPU of its own (box N -> the Nth box
# CPU, round-robin), enforced by a per-box cpuset; with 4+ CPUs the first
# is kept free for the API. off: boxes may use every CPU (timings then
# depend on load). The syscall filter is not configurable: every box runs
# isolate's strictest one, except that Go compile boxes may take file locks.
ISOLATE_CPU_PINNING=round-robin
EXECUTION_RATE_LIMIT_MAX=6000

# ── Directus ───────────────────────────────────────────────────────────────
DIRECTUS_SECRET=CHANGE-ME-directus-secret
# Bootstrap admin, created on the first start only; change the password in
# Directus afterwards and keep this in sync for the directus-config job.
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE-ME-directus-admin

# ── backups (restic over SFTP to a Hetzner Storage Box) ────────────────────
BACKUP_AT=03:15
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
# Storage Box: u123456.your-storagebox.de, SSH/SFTP on port 23.
BACKUP_SSH_HOST=u123456.your-storagebox.de
BACKUP_SSH_USER=u123456
BACKUP_SSH_PORT=23
# Path is relative to the storage box home directory.
RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:codemare-restic
# Encrypts every backup. Store a copy OFF the server (password manager):
# without it the backups cannot be restored.
RESTIC_PASSWORD=CHANGE-ME-restic-password
# Created by the provisioning steps in deploy/README.md (never committed).
BACKUP_SSH_KEY_FILE=./deploy/secrets/storagebox_ed25519
BACKUP_KNOWN_HOSTS_FILE=./deploy/secrets/storagebox_known_hosts
# Optional dead-man's switch (e.g. https://hc-ping.com/<uuid>): pinged on
# start, success and /fail.
BACKUP_PING_URL=
