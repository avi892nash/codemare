{
  "name": "codemare-web",
  "version": "0.1.0",
  "private": true,
  "description": "Codemare web app — Next.js (App Router) frontend + user-facing API. Calls the compile service over HTTPS with X-Codemare-Token.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.0",
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^5.20.0",
    "next": "^15.0.3",
    "next-auth": "5.0.0-beta.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
