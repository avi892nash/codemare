{
  "name": "codemare-web",
  "version": "0.1.0",
  "private": true,
  "description": "Codemare web app — Next.js (App Router) frontend + user-facing API. Calls the compile service over HTTPS with X-Codemare-Token.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev -p 4001",
    "build": "next build",
    "start": "next start -p 4001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node prisma/with-env.mjs prisma migrate dev",
    "db:deploy": "node prisma/with-env.mjs prisma migrate deploy",
    "db:reset": "node prisma/with-env.mjs prisma migrate reset",
    "seed": "node prisma/with-env.mjs tsx prisma/seed/index.ts",
    "seed:fixtures": "node prisma/with-env.mjs tsx prisma/seed/index.ts --dir prisma/seed/fixtures"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@auth/prisma-adapter": "^2.7.0",
    "@monaco-editor/react": "^4.6.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.26",
    "next-auth": "^5.0.0-beta.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.4.49",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
