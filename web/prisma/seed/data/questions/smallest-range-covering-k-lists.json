    {"input":[[[1,2,3],[1,2,3],[1,2,3]]],"expected":[1,1],"hidden":false,"explain_on_fail":"A value shared by every list gives a zero-width range."},
    {"input":[[[10],[20]]],"expected":[10,20],"hidden":false,"explain_on_fail":"Single-value lists."},
    {"input":[[[1,3,5,7],[2,4,6,8]]],"expected":[1,2],"hidden":false,"explain_on_fail":"Interleaved lists — several ranges tie on width, so the smallest start wins."},
    {"input":[[[5]]],"expected":[5,5],"hidden":true,"explain_on_fail":"A single list with a single value."},
    {"input":[[[-3,-1],[-2,0]]],"expected":[-3,-2],"hidden":true,"explain_on_fail":"Negative values and a tie on width."},
    {"input":[[[1,1,1],[1,1,2]]],"expected":[1,1],"hidden":true,"explain_on_fail":"Duplicate values inside the lists."},
