    "python": "import heapq\n\ndef smallestRange(nums):\n    heap = [(lst[0], i, 0) for i, lst in enumerate(nums)]\n    heapq.heapify(heap)\n    hi = max(lst[0] for lst in nums)\n    best = [heap[0][0], hi]\n    while True:\n        lo, i, j = heapq.heappop(heap)\n        if hi - lo < best[1] - best[0] or (hi - lo == best[1] - best[0] and lo < best[0]):\n            best = [lo, hi]\n        if j + 1 == len(nums[i]):\n            return best\n        nxt = nums[i][j + 1]\n        hi = max(hi, nxt)\n        heapq.heappush(heap, (nxt, i, j + 1))\n",
    "javascript": "function smallestRange(nums) {\n  // Merge everything, then slide a window that covers every list at least once.\n  const items = [];\n  nums.forEach((lst, i) => { for (const v of lst) items.push([v, i]); });\n  items.sort((a, b) => a[0] - b[0] || a[1] - b[1]);\n  const count = new Array(nums.length).fill(0);\n  let covered = 0, l = 0, best = null;\n  for (let r = 0; r < items.length; r++) {\n    if (count[items[r][1]]++ === 0) covered++;\n    while (covered === nums.length) {\n      const a = items[l][0], b = items[r][0];\n      if (best === null || b - a < best[1] - best[0] || (b - a === best[1] - best[0] && a < best[0])) best = [a, b];\n      if (--count[items[l][1]] === 0) covered--;\n      l++;\n    }\n  }\n  return best;\n}\n"
