{
  "slug": "smallest-range-covering-k-lists",
  "title": "Smallest Range Covering K Lists",
  "difficulty": "Hard",
  "statement_md": "You're given `k` lists of integers, each sorted in non-decreasing order. Find the smallest range `[a, b]` that contains **at least one number from every list**.\n\nA range `[a, b]` is smaller than `[c, d]` if `b - a < d - c`, or if the widths are equal and `a < c`. Return the smallest range as a two-element array `[a, b]`.",
  "examples": [
    {
      "input": "nums = [[1,5,9],[4,12],[7,10,16]]",
      "output": "[4,7]",
      "explanation": "4 (second list), 5 (first list) and 7 (third list) all lie in [4,7], and no narrower range touches all three lists."
    },
    {
      "input": "nums = [[1,2,3],[1,2,3],[1,2,3]]",
      "output": "[1,1]",
      "explanation": "1 appears in every list, so a zero-width range works."
    },
    {
      "input": "nums = [[10],[20]]",
      "output": "[10,20]",
      "explanation": "Each list has one value, so the range must stretch from 10 to 20."
    }
  ],
  "constraints": [
    "1 <= k <= 500",
    "1 <= nums[i].length <= 50",
    "-10^5 <= nums[i][j] <= 10^5",
    "Each nums[i] is sorted in non-decreasing order."
  ],
  "function_name": "smallestRange",
  "signature": {"params": [{"name": "nums", "type": "int[][]"}], "returns": "int[]"},
  "compare_mode": "ordered",
  "starter_code": {
    "python": "def smallestRange(nums):\n    # Write your code here\n    pass\n",
    "javascript": "function smallestRange(nums) {\n    // Write your code here\n}\n",
    "typescript": "function smallestRange(nums: number[][]): number[] {\n    // Write your code here\n    return [];\n}\n",
    "cpp": "#include <vector>\nusing namespace std;\n\nvector<int> smallestRange(vector<vector<int>>& nums) {\n    // Write your code here\n    return {};\n}\n",
    "java": "class Solution {\n    public static int[] smallestRange(int[][] nums) {\n        // Write your code here\n        return new int[]{};\n    }\n}\n",
    "go": "func smallestRange(nums [][]int) []int {\n\t// Write your code here\n\treturn nil\n}\n"
  },
