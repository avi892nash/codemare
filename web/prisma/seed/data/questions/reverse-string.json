  "reference_solutions": {
    "python": "def reverseString(s):\n    i, j = 0, len(s) - 1\n    while i < j:\n        s[i], s[j] = s[j], s[i]\n        i += 1\n        j -= 1\n    return s\n",
    "javascript": "function reverseString(s) {\n  for (let i = 0, j = s.length - 1; i < j; i++, j--) {\n    const tmp = s[i];\n    s[i] = s[j];\n    s[j] = tmp;\n  }\n  return s;\n}\n"
  },
