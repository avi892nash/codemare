    "python": "def subsets(nums):\n    result = [[]]\n    for x in nums:\n        result += [subset + [x] for subset in result]\n    return result\n",
    "javascript": "function subsets(nums) {\n  const out = [];\n  const cur = [];\n  (function choose(i) {\n    if (i === nums.length) { out.push(cur.slice()); return; }\n    choose(i + 1);          // leave nums[i] out\n    cur.push(nums[i]);\n    choose(i + 1);          // take nums[i]\n    cur.pop();\n  })(0);\n  return out;\n}\n"
