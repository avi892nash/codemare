  "statement_md": "Given an integer `n`, return every string made of exactly `n` opening and `n` closing parentheses that is **balanced**: reading left to right, the number of `)` never exceeds the number of `(` read so far, and the two totals are equal at the end.\n\nReturn the strings in any order.",
  "examples": [
    {
      "input": "n = 1",
      "output": "[\"()\"]",
      "explanation": "The only balanced string with one pair."
    },
    {
      "input": "n = 2",
      "output": "[\"(())\",\"()()\"]",
      "explanation": "Two pairs can be nested or placed side by side."
    },
    {"input": "n = 3", "output": "[\"((()))\",\"(()())\",\"(())()\",\"()(())\",\"()()()\"]"}
  ],
  "constraints": ["1 <= n <= 8"],
  "function_name": "generateParenthesis",
