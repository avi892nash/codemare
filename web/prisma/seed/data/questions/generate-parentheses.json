  "reference_solutions": {
    "python": "def generateParenthesis(n):\n    out = []\n\n    def build(prefix, opened, closed):\n        if len(prefix) == 2 * n:\n            out.append(prefix)\n            return\n        if opened < n:\n            build(prefix + '(', opened + 1, closed)\n        if closed < opened:\n            build(prefix + ')', opened, closed + 1)\n\n    build('', 0, 0)\n    return out\n",
    "javascript": "function generateParenthesis(n) {\n  // Every balanced string is \"(\" + A + \")\" + B with A, B balanced and shorter.\n  const byPairs = [['']];\n  for (let k = 1; k <= n; k++) {\n    const list = [];\n    for (let i = 0; i < k; i++) {\n      for (const a of byPairs[i]) {\n        for (const b of byPairs[k - 1 - i]) list.push('(' + a + ')' + b);\n      }\n    }\n    byPairs.push(list);\n  }\n  return byPairs[n];\n}\n"
