{
  "slug": "longest-increasing-subsequence",
  "title": "Longest Increasing Subsequence",
  "difficulty": "Medium",
  "statement_md": "Given an integer array `nums`, return the length of its longest **strictly increasing subsequence**.\n\nA subsequence keeps the original order but may skip elements. Strictly increasing means each chosen value is larger than the one chosen before it.\n\nAn O(n²) dynamic program is enough for these limits; an O(n log n) solution uses binary search.",
  "examples": [
    {
      "input": "nums = [3,1,4,1,5,9,2,6]",
      "output": "4",
      "explanation": "One longest choice is 1, 4, 5, 9 (1, 4, 5, 6 works too)."
    },
    {
      "input": "nums = [7,7,7]",
      "output": "1",
      "explanation": "Equal values are not increasing, so only one of them can be used."
    },
    {
      "input": "nums = [1,2,3,4]",
      "output": "4",
      "explanation": "The whole array already increases."
    }
  ],
  "constraints": ["1 <= nums.length <= 2000", "-10^4 <= nums[i] <= 10^4"],
  "function_name": "lengthOfLIS",
  "signature": {"params": [{"name": "nums", "type": "int[]"}], "returns": "int"},
  "compare_mode": "ordered",
  "starter_code": {
    "python": "def lengthOfLIS(nums):\n    # Write your code here\n    pass\n",
    "javascript": "function lengthOfLIS(nums) {\n    // Write your code here\n}\n",
    "typescript": "function lengthOfLIS(nums: number[]): number {\n    // Write your code here\n    return 0;\n}\n",
    "cpp": "#include <vector>\nusing namespace std;\n\nint lengthOfLIS(vector<int>& nums) {\n    // Write your code here\n    return 0;\n}\n",
    "java": "class Solution {\n    public static int lengthOfLIS(int[] nums) {\n        // Write your code here\n        return 0;\n    }\n}\n",
    "go": "func lengthOfLIS(nums []int) int {\n\t// Write your code here\n\treturn 0\n}\n"
  },
  "tests": [
    {"input":[[3,1,4,1,5,9,2,6]],"expected":4,"hidden":false,"explain_on_fail":"A scrambled array with several longest subsequences."},
    {"input":[[7,7,7]],"expected":1,"hidden":false,"explain_on_fail":"Equal values never extend a strictly increasing subsequence."},
    {"input":[[1,2,3,4]],"expected":4,"hidden":false,"explain_on_fail":"An already increasing array."},
    {"input":[[-5,-10,0,-3,4]],"expected":3,"hidden":false,"explain_on_fail":"Negative numbers."},
    {"input":[[5]],"expected":1,"hidden":true,"explain_on_fail":"A single element."},
    {"input":[[9,7,5,3]],"expected":1,"hidden":true,"explain_on_fail":"Strictly decreasing — no two elements can be chained."},
    {"input":[[0,8,4,12,2,10,6,14,1,9,5,13,3,11,7,15]],"expected":6,"hidden":true,"explain_on_fail":"A scrambled sequence where the best subsequence zig-zags through the array."},
    {"input":[[2,2,3,3,4,4]],"expected":3,"hidden":true,"explain_on_fail":"Repeated values can each be used at most once in the chain."},
    {"input":[[4,10,4,3,8,9]],"expected":3,"hidden":true,"explain_on_fail":"An early large value must not block a longer chain that starts smaller."},
