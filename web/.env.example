# Copy to .env.local for dev. All vars here are SERVER-only — never prefix
# with NEXT_PUBLIC_ unless you're 100% sure they should ship to the browser.

# Compile service URL (the backend in this monorepo, deployed via deploy/install.sh)
COMPILE_SERVICE_URL=http://localhost:3000

# Shared secret with the compile service. The Next.js server attaches this as
# X-Codemare-Token on every outbound request to COMPILE_SERVICE_URL. Match the
# value in /etc/codemare/env on the compile host.
INTERNAL_TOKEN=replace-me-with-openssl-rand-hex-32

# Postgres for users / problems / submissions. Any provider — Neon, Supabase,
# RDS, local docker, whatever.
DATABASE_URL=postgresql://user:pass@localhost:5432/codemare

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
